#!/usr/bin/env bash
# redirect ["<message>"]
# Types a message into every running agent. With no message, tells each agent
# to merge origin/eddy and re-read research/CLAUDE.md and research/baseline.md.
# Run anywhere on O2; it hops to the agent-host node, where the sessions live.
set -euo pipefail

HOST=$(cat "$HOME/.nrfm-agent-host")
[[ $(hostname) == "$HOST" ]] || exec ssh -q "$HOST" "$(realpath "$0")" "$(printf '%q' "${1:-}")"

MSG=${1:-"Instruction from the human: run git fetch origin && git merge --no-edit origin/eddy, then re-read research/CLAUDE.md and research/baseline.md and follow them from now on. Record this redirection under current state, commit and push."}

for s in $(tmux ls -F '#S' | sed -n 's/^nrfm-//p'); do
  tmux send-keys -t "=nrfm-$s:" -l "$MSG"
  tmux send-keys -t "=nrfm-$s:" Enter
  echo "sent to $s"
done
